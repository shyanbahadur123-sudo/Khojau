# Khojau-only environment. Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated admin emails for dashboard access, e.g. founder@khojau.com
ADMIN_EMAILS=
# K-03: set to "true" to require a verified MFA factor for /admin + admin APIs.
# Owner checklist before enabling: Supabase dashboard → Authentication → MFA
# (enable TOTP), enroll an authenticator app on each admin account, restart.
# ADMIN_REQUIRE_MFA=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
